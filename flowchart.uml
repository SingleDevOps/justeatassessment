@startuml
!theme plain
title Just Eat Finder — main Branch Flow

start
:User enters postcode in SearchBar and submits;

:Format postcode (remove spaces, uppercase);

if (No internet connection) then (true)
  :Show Alert 'No Internet Connection';
  stop
else (false)
  :Show loading indicator;

  if (Postcode is empty or 'L40TH') then (true)
    :Load sample data (src/assets/data/L40TH.json);
    :Simulate 1s delay, pick random 10 restaurants;
  else (false)
    fork
      :Call validatePostcode API (postcodes.io);
    fork again
      :Timeout after 3s;
    end fork

    if (Validation result is TIMEOUT or true) then (Valid / timeout: proceed)
      :Call fetchRestaurantsFromJustEat (Just Eat endpoint);
      if (Returns null) then (API Error)
        :Show Alert 'Just Eat API Down or IP not European';
        stop
      else (Success)
        :Pick random 10 restaurants;
      endif
    else (false: Invalid postcode)
      :Show Alert 'Invalid Postcode';
      stop
    endif
  endif

  :Navigate to DisplayPage with restaurants;
  :Display retrieved restaurant data;
endif

stop
@enduml
